. ~/.env
alias i="apk add"
alias r="apk del"
alias s="apk search"
alias c="clear"
alias gu="git pull"
alias gp="git push"
alias gs="git status"
alias ga="git add "
alias gd="git diff"
alias gc="git commit -m"
alias gl="git log --oneline --graph --decorate"
alias ggn='git config --global user.name "Mohamed Elbagoury"'
alias ggm='git config --global user.email ${HOTMAIL}'
alias ll="ls -lah"
alias sci="ssh-copy-id" # user@server_ip
alias soi='ssh ${OI_IP}'
alias sor='ssh ${ORJ_IP}'


